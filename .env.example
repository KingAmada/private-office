# App
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
APP_ENCRYPTION_KEY=replace-with-another-long-random-string

# Google Cloud OAuth 2.0 Web Application
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Safer split: read existing Drive files, but write/manage only files the app creates or the user opens with it.
# A public app may still require Google verification for Drive access.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/drive.file

# OpenAI API
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Private Office behavior
PRIVATE_OFFICE_ROOT=Private Office
AUTO_ORGANIZE_CONFIDENCE=0.82
MAX_UPLOAD_MB=30
MAX_SYNC_FILES_PER_RUN=15

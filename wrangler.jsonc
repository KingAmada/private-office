{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "private-office",
  "main": "worker/vault-gateway.js",
  "compatibility_date": "2026-08-28",
  "keep_vars": true,
  "vars": {
    "APP_ORIGINS": "https://kingamada.github.io",
    "APP_URL": "https://kingamada.github.io/private-office/",
    "OPENAI_MODEL": "gpt-5.6-luna"
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY"
    ]
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "private-office"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "private-office-db",
      "database_id": "95393c66-587e-4153-95f9-9bbe9d2286ec"
    }
  ],
  "observability": {
    "enabled": true
  }
}
